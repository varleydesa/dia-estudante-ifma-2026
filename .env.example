PORT=3000

# Usados apenas para criar a conta de admin na primeira vez que o servidor roda.
ADMIN_USER_INICIAL=admin@exemplo.com
ADMIN_SENHA_INICIAL=troque-esta-senha

# Chave para assinar o cookie de sessão. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: em produção, aponte para um banco Turso (veja o README) para não
# depender de disco persistente no servidor. Deixe em branco para usar um
# arquivo SQLite local (bom para desenvolvimento).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
